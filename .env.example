# Copy to .env and fill in. Never commit .env.

# cloud = Claude + Cohere (same as the hosted demo); offline = Ollama, nothing leaves your Mac
GIGAWHAT_PROFILE=cloud

# Cloud profile
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# Offline profile
GIGAWHAT_OLLAMA_URL=http://localhost:11434

# Tracing (optional): https://cloud.langfuse.com, EU region
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
