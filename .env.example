# Copy to .env and fill in. Never commit .env.

# cloud = Gemini's free tier for chat, OpenAI embeddings, Cohere or local reranking;
# offline = gpt-oss on Ollama and a local reranker, nothing leaves your Mac
GIGAWHAT_PROFILE=cloud
# Cloud reranker: cohere (default, needs COHERE_API_KEY) or local (bge-reranker-v2-m3 on this
# machine; needs PyTorch, which the container image leaves out). Offline always reranks locally.
# GIGAWHAT_RERANKER=cohere

# Each chat role has a default per profile (see `gigawhat doctor`). Override one as
# provider:model, with provider gemini, groq or ollama, e.g. when a model's daily quota is used up.
# The offline profile accepts only ollama.
# GIGAWHAT_FAST_MODEL=gemini:gemini-2.5-flash-lite
# GIGAWHAT_ANSWER_MODEL=groq:openai/gpt-oss-20b

# Cloud profile. Gemini's free tier: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
OPENAI_API_KEY=
# Optional: only if a chat role is switched to Groq (its free plan is too small for answers)
GROQ_API_KEY=
# Optional: only with GIGAWHAT_RERANKER=cohere
COHERE_API_KEY=

# Offline profile
GIGAWHAT_OLLAMA_URL=http://localhost:11434
# After the first run has downloaded the tokenizer and reranker, stop all HuggingFace calls:
# HF_HUB_OFFLINE=1

# Tracing and evaluation experiments (optional, cloud profile only): https://smith.langchain.com
# A key works only in the region it was created in: EU (default below) or US
# (https://api.smith.langchain.com). `gigawhat doctor` checks the key against the endpoint.
# Don't set LANGSMITH_TRACING: GigaWhat attaches the tracer itself, and that variable would
# also trace the offline profile.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=gigawhat
