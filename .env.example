# Copy to .env and fill in. Never commit .env.

# cloud = gpt-oss on Groq, OpenAI embeddings, Cohere reranking (same as the hosted demo);
# offline = the same gpt-oss model on Ollama, nothing leaves your Mac
GIGAWHAT_PROFILE=cloud
# Cloud reranker: cohere (default, needs COHERE_API_KEY) or local (bge-reranker-v2-m3 on this
# machine; needs PyTorch, which the hosted image leaves out). Offline always reranks locally.
# GIGAWHAT_RERANKER=cohere

# Cloud profile. Groq's free plan allows 8K tokens a minute, less than one long answer prompt:
# use its Developer plan. A Cohere trial key is fine for development, not for the hosted demo.
GROQ_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=

# Offline profile
GIGAWHAT_OLLAMA_URL=http://localhost:11434
# After the first run has downloaded the tokenizer and reranker, stop all HuggingFace calls:
# HF_HUB_OFFLINE=1

# Tracing (optional, cloud profile only): https://eu.smith.langchain.com
# Don't set LANGSMITH_TRACING: GigaWhat attaches the tracer itself, and that variable would
# also trace the offline profile.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=gigawhat
